# MedTrace configuration. Copy to .env and fill in. Real environment variables override .env.
# NEVER commit a real .env. The values below are placeholders, not working secrets.

# --- Mode ------------------------------------------------------------------
# 1 = local demo: allows the public demo secrets below to be left unset, enables
# demo reset (wipes data), the printable demo kit and the SIMULATED temperature feed.
# `npm run demo` sets this to 1 automatically. Leave unset/0 for anything real.
MEDTRACE_DEMO_MODE=0

# --- Secrets (required outside demo mode; the server refuses to start without them) ---
# Relayer: the account that deploys the contract and pays gas for every transaction.
# Generate: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
RELAYER_PRIVATE_KEY=
# HD seed for the per-user signing keys held by the server (see README: trust model).
# Generate: node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
MEDTRACE_WALLET_MNEMONIC=
# HMAC key for QR package labels. Changing it invalidates every printed label.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDTRACE_LABEL_SECRET=
# Optional: key for short-lived evidence links (random per process if unset).
MEDTRACE_EVIDENCE_LINK_SECRET=

# --- Ledger ----------------------------------------------------------------
RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337
NETWORK_ID=5777
# How long to wait for a transaction confirmation before marking it "unconfirmed" (ms).
MEDTRACE_TX_TIMEOUT_MS=30000

# --- Server ----------------------------------------------------------------
PORT=4000
# MEDTRACE_DATA_DIR=server/data
# Serve over HTTPS (phones only allow the camera on HTTPS):
# MEDTRACE_TLS_CERT=cert.pem
# MEDTRACE_TLS_KEY=key.pem

# --- Policies --------------------------------------------------------------
MEDTRACE_LOGIN_MAX_FAILURES=5
MEDTRACE_LOGIN_LOCK_MINUTES=5
MEDTRACE_EVIDENCE_LINK_SECONDS=300
# Shipments in transit longer than this are flagged overdue on the audit dashboard.
MEDTRACE_TRANSIT_SLA_HOURS=48
# Default minimum duration of an out-of-range run that counts as a cold-chain excursion.
# A product's eLMIS storage condition can override it (orderable.storage.toleranceMinutes).
MEDTRACE_COLDCHAIN_TOLERANCE_MINUTES=15

# --- Evidence --------------------------------------------------------------
# Optional Kubo (go-ipfs) API. Unset = local IPFS-compatible block store (same CIDs).
# IPFS_API_URL=http://127.0.0.1:5001
