# ---------------------------------------------------------------------------
# MedTrace .gitignore
# ---------------------------------------------------------------------------

# Dependencies (reinstall with `npm install`)
node_modules/

# Runtime data: demo database, local chain state, evidence files, sessions.
# Never commit: it may contain photos and session data.
server/data/

# Secrets and local configuration. Commit .env.example only.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
keystore/
secrets/

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Test and coverage output
coverage/
.nyc_output/
test-results/

# Python helpers (test/tools)
__pycache__/
*.pyc
.venv/
venv/

# Local AI assistant settings
.claude/settings.local.json

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
*~
.~lock.*#
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
*.tmp
